# Copy to .env.production and fill in real values (never commit .env.production).

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-db-password
POSTGRES_DB=mandisync_db

# Shared secret for X-API-Key (farmer UI + admin UI + API).
API_KEY=change-me-long-random-api-key

# Browser origins that may call the API (comma-separated).
# After you have a public domain, add https://your-domain.com
ALLOWED_ORIGINS=http://localhost:3000

# Built into the Next.js bundle (visible in the browser — expected for this SPA).
# On Oracle/VPS use http://YOUR_PUBLIC_IP:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

GEMINI_API_KEY=
AGMARKNET_API_KEY=

ALLOW_SEED_FALLBACK=false
INGEST_INTERVAL_SECONDS=86400

# Farmer / admin logins (JWT). Change after first sign-in.
APP_USER_USERNAME=farmer
APP_USER_PASSWORD=farmer123
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123
JWT_SECRET=change-me-jwt-secret

API_PORT=8000
WEB_PORT=3000
