# Comma-separated browser origins allowed to call the API.
ALLOWED_ORIGINS=http://localhost:3000

# Postgres (optional — defaults to local docker-compose).
# DATABASE_URL=postgresql://postgres:mandisync_password@localhost:5432/mandisync_db

# Shared secret for X-API-Key on /api/arbitrage/* routes.
API_KEY=replace-with-a-long-random-string

# Google Gemini (never commit a real key).
GEMINI_API_KEY=replace-with-gemini-api-key

# data.gov.in Agmarknet resource key (never commit a real key).
AGMARKNET_API_KEY=replace-with-data-gov-in-api-key

# Live product default: do NOT fall back to seed.py prices when Agmarknet is
# stale/missing. Set true only for offline demos / local UI work.
ALLOW_SEED_FALLBACK=false

# Login accounts (JWT). Change these in production.
APP_USER_USERNAME=farmer
APP_USER_PASSWORD=farmer123
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=admin123
# JWT_SECRET=replace-with-a-long-random-string


# Docker entrypoint sets this so import does not connect before Postgres is up.
# SKIP_DB_INIT_ON_IMPORT=true
